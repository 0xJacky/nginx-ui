msgstr "Público, como el servidor."

msgid "Access"
msgstr "Acceso"

msgid "Public (ACME challenge)"
msgstr "Público (desafío ACME)"

msgid "Restrict this location? Certificate renewals over HTTP-01 will fail."
msgstr ""
"¿Restringir esta ubicación? Las renovaciones de certificados por HTTP-01 "
