msgid "IP Certificate Notice"
msgstr "Aviso de certificado IP"

#: src/components/AutoCertForm/AutoCertForm.vue:81
msgid ""
"This site is configured as a default server (default_server) for HTTPS (port "
"443). "
msgstr ""
"Este sitio está configurado como servidor predeterminado (default_server) "
"para HTTPS (puerto 443)."

