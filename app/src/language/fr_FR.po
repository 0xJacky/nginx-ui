msgid "No file matches the search"
msgstr "Aucun fichier ne correspond à la recherche"

msgid ""
"The file name must end in .conf and use only letters, digits, dots, dashes "
"and underscores"
msgstr ""
"Le nom de fichier doit se terminer par .conf et ne contenir que des "
"lettres, des chiffres, des points, des tirets et des tirets bas"

msgid "Snippet not found"
msgstr "Extrait introuvable"

msgid "The snippet exceeds 256 KiB"
msgstr "Le fragment dépasse 256 KiB"

msgid "The header of the snippet does not parse: {0}"
msgstr "L'en-tête du fragment de code ne peut pas être analysé : {0}"

msgid "The snippet is still included by {0}"
msgstr "L'extrait est toujours inclus par {0}"

msgid "A snippet with this file name already exists"
msgstr "Un extrait portant ce nom de fichier existe déjà"

msgid "The variable {0} is invalid: {1}"
msgstr "La variable {0} est invalide : {1}"

