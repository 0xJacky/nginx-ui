msgstr "Khởi động lại Nginx"

msgid "Online"
msgstr "Trực tuyến"

msgid "Offline"
msgstr "Ngoại tuyến"

msgid "Nginx reloaded successfully"
msgstr "Nginx đã tải lại thành công"

