msgstr "unit systemd có định nghĩa ExecReload"

msgid "Add a bind mount: -v %{source}:%{target}"
msgstr "Thêm bind mount: -v %{source}:%{target}"

msgid "Append the missing entries to %{path} (see the Install step)."
msgstr "Thêm các mục còn thiếu vào %{path} (xem bước Cài đặt)."

msgid "Confirm that the address reaches the machine running nginx."
msgstr "Xác nhận rằng địa chỉ có thể truy cập máy đang chạy nginx."

msgid ""
"This is expected on Docker Desktop. On other runtimes, confirm that the "
"address reaches the machine running nginx."
msgstr ""
"Đây là hành vi bình thường trên Docker Desktop. Với các môi trường chạy "
"khác, hãy xác nhận rằng địa chỉ có thể truy cập máy đang chạy nginx."

msgid ""
"Confirm that the SSH server is running, the user exists, and the key or "
"password is correct."
msgstr ""
"Xác nhận máy chủ SSH đang chạy, người dùng tồn tại và khóa hoặc mật khẩu là "
"chính xác."

msgid ""
"Confirm that the systemd unit name matches the installation, such as "
"nginx.service or openresty.service."
msgstr ""
"Xác nhận tên unit systemd khớp với bản cài đặt, chẳng hạn nginx.service hoặc "
"openresty.service."

msgid "Confirm that the configured SSH user owns the Homebrew service."
msgstr "Xác nhận người dùng SSH đã cấu hình là chủ sở hữu dịch vụ Homebrew."

msgid "Confirm that the configured nginx directory exists on the host."
msgstr "Xác nhận thư mục nginx đã cấu hình tồn tại trên máy chủ."

msgid "Confirm that the container runtime provides host.docker.internal."
msgstr "Xác nhận môi trường chạy container cung cấp host.docker.internal."

msgid "Confirm that /usr/bin/uname exists on the host."
msgstr "Xác nhận /usr/bin/uname tồn tại trên máy chủ."

msgid ""
"Correct the highlighted path or identifier, then run verification again."
msgstr ""
"Sửa đường dẫn hoặc mã định danh được đánh dấu rồi chạy lại bước xác minh."

msgid "Fix the nginx configuration error shown in the details."
msgstr "Sửa lỗi cấu hình nginx được hiển thị trong phần chi tiết."

msgid "Run `sudo -l` on the host to inspect the configured permissions."
msgstr "Chạy `sudo -l` trên máy chủ để kiểm tra các quyền đã cấu hình."

msgid "Inspect the systemd unit file."
msgstr "Kiểm tra tệp unit systemd."

msgid ""
"Bind-mount the host nginx log directory read-only at the configured "
"container log path, and ensure the container can read it."
msgstr ""
"Bind mount thư mục nhật ký nginx của máy chủ ở chế độ chỉ đọc vào đường dẫn "
"nhật ký đã cấu hình trong container và bảo đảm container có thể đọc thư mục "
"đó."

msgid ""
"Bind-mount the host PID directory containing %{path} at the same container "
"path."
msgstr ""
"Bind mount thư mục PID trên máy chủ chứa %{path} vào cùng đường dẫn trong "
"container."

msgid ""
"Persist /etc/nginx-ui with a Docker named volume or bind mount so "
"known_hosts survives container rebuilds."
msgstr ""
"Lưu bền vững /etc/nginx-ui bằng volume Docker có tên hoặc bind mount để "
"known_hosts không bị mất khi tạo lại container."

msgid "Replace the mount with: -v %{source}:%{target}"
msgstr "Thay mount bằng: -v %{source}:%{target}"

msgid "Some packages omit ExecReload. Use `systemctl restart` instead."
msgstr "Một số gói không có ExecReload. Hãy dùng `systemctl restart` thay thế."

msgid "If this is a remote host, review the cluster Node cross-host guide."
msgstr ""
"Nếu đây là máy chủ từ xa, hãy xem hướng dẫn liên máy chủ dành cho Node của "
"cụm."

msgid "Review the file permission commands in the Install step."
msgstr "Xem lại các lệnh quyền tệp trong bước Cài đặt."

msgid "Review the sudoers rules shown in the Install step."
msgstr "Xem lại các quy tắc sudoers được hiển thị trong bước Cài đặt."

msgid "Select the service manager that matches the SSH host."
msgstr "Chọn trình quản lý dịch vụ phù hợp với máy chủ SSH."

msgid "Run `brew services start nginx` as the configured SSH user."
msgstr "Chạy `brew services start nginx` bằng người dùng SSH đã cấu hình."

msgid ""
"Review the cluster Node cross-host guide for the correct deployment method."
msgstr ""
"Xem hướng dẫn liên máy chủ dành cho Node của cụm để chọn phương thức triển "
"khai đúng."

msgid "Use host.docker.internal when nginx runs on the Docker host."
msgstr "Dùng host.docker.internal khi nginx chạy trên máy chủ Docker."

msgid "Use host.docker.internal when nginx runs on the macOS host."
msgstr "Dùng host.docker.internal khi nginx chạy trên máy chủ macOS."

msgid "Verify the bind mount manually."
msgstr "Xác minh bind mount theo cách thủ công."

