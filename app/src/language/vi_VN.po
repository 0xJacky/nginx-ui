msgstr "Lần cập nhật cuối:"

msgid "Nginx configuration test failed"
msgstr "Kiểm tra cấu hình Nginx không thành công"

msgid "Sandbox validation skipped"
msgstr "Đã bỏ qua kiểm tra sandbox"

msgid "Sandbox validation failed"
msgstr "Xác thực sandbox thất bại"

msgid "Error"
msgstr "Lỗi"

msgid "Config validation is unavailable for a remote-only namespace."
msgstr ""
"Xác thực cấu hình không khả dụng đối với không gian tên chỉ dành cho từ xa."

msgid ""
"Sandbox validation is unavailable when Nginx runs in a separate container."
msgstr ""
"Xác thực sandbox không khả dụng khi Nginx chạy trong một container riêng "
"biệt."

msgid ""
"Sandbox validation is unavailable because a custom test command is "
"configured."
msgstr ""
"Xác thực sandbox không khả dụng vì một lệnh kiểm tra tùy chỉnh đã được cấu "
"hình."

msgid ""
"A required include file is missing from the sandbox or source configuration."
msgstr "Thiếu tệp include bắt buộc trong sandbox hoặc cấu hình nguồn."

msgid "Sandbox setup failed before Nginx could validate the configuration."
msgstr ""
"Thiết lập môi trường kiểm thử thất bại trước khi Nginx có thể xác thực cấu "
"hình."

msgid "Nginx reported a configuration syntax error."
msgstr "Nginx báo cáo lỗi cú pháp cấu hình."

msgid "Nginx failed to validate the configuration."
msgstr "Nginx không thể xác thực cấu hình."

msgid "Server error"
msgstr "Lỗi máy chủ"

msgid "Testing Nginx configuration..."
msgstr "Đang kiểm tra cấu hình Nginx..."

msgid "Could not reach the server"
msgstr "Không thể kết nối đến máy chủ"

msgid "Configuration file is test successful in isolated sandbox"
msgstr "Tệp cấu hình đã được kiểm tra thành công trong môi trường cát cách ly"

msgid "Configuration file is test successful"
msgstr "Tệp cấu hình được kiểm tra thành công"

