msgstr "Chẩn đoán mục tiêu"

msgid "Detect again"
msgstr "Phát hiện lại"

msgid "Detect target"
msgstr "Phát hiện mục tiêu"

msgid "Every field matches the detected values"
msgstr "Mọi trường đều khớp với giá trị đã phát hiện"

msgid "Some fields differ from the detected values"
msgstr "Một số trường khác với giá trị đã phát hiện"

