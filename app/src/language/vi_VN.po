msgstr "Xóa chứng chỉ từ cơ sở dữ liệu thất bại: %{error}"

msgid "Failed to revoke certificate: %{error}"
msgstr "Không thể thu hồi chứng chỉ: %{error}"

msgid "GeoLite2 database available"
msgstr "Cơ sở dữ liệu GeoLite2 có sẵn"

msgid "HTTP challenge route is reachable"
msgstr "Tuyến đường thử thách HTTP có thể truy cập được"

msgid "HTTP challenge route probe is unavailable"
msgstr "Không thể kiểm tra tuyến đường thử thách HTTP"

msgid "HTTP configuration applied"
msgstr "Đã áp dụng cấu hình HTTP"

msgid "HTTP configuration restored"
msgstr "Đã khôi phục cấu hình HTTP"

msgid "HTTPS configuration planned"
msgstr "Đã lập kế hoạch cấu hình HTTPS"

msgid "HTTPS enabled"
msgstr "HTTPS đã được bật"

msgid "Issuing the certificate"
msgstr "Đang cấp chứng chỉ"

msgid ""
"Log file %{log_path} is not a regular file. If you are using nginx-ui in "
"docker container, please refer to https://nginxui.com/zh_CN/guide/config-"
"nginx-log.html for more information."
msgstr ""
"Tệp nhật ký %{log_path} không phải là tệp thông thường. Nếu bạn đang sử dụng "
"nginx-ui trong container docker, vui lòng tham khảo https://nginxui.com/"
"zh_CN/guide/config-nginx-log.html để biết thêm thông tin."

msgid "Nginx PID path exists"
msgstr "Đường dẫn PID của Nginx tồn tại"

msgid ""
"Nginx UI could not listen on the HTTP challenge port; make sure no other "
"process uses it, or change the HTTP challenge port in the certificate "
"settings."
msgstr ""
"Nginx UI không thể lắng nghe trên cổng HTTP challenge; hãy đảm bảo không có "
"tiến trình nào khác sử dụng nó, hoặc thay đổi cổng HTTP challenge trong cài "
"đặt chứng chỉ."

msgid "Nginx access log path exists"
msgstr "Đường dẫn nhật ký truy cập Nginx tồn tại"

msgid "Nginx configuration directory exists"
msgstr "Thư mục cấu hình Nginx tồn tại"

msgid "Nginx configuration entry file exists"
msgstr "Tập tin cấu hình đầu vào Nginx tồn tại"

msgid "Nginx error log path exists"
msgstr "Đường dẫn nhật ký lỗi Nginx tồn tại"

msgid "Nginx sbin path exists"
msgstr "Đường dẫn sbin của Nginx tồn tại"

msgid "Nginx.conf includes conf.d directory"
msgstr "Nginx.conf bao gồm thư mục conf.d"

msgid "Nginx.conf includes sites-enabled directory"
msgstr "Nginx.conf bao gồm thư mục sites-enabled"

msgid "Nginx.conf includes streams-enabled directory"
msgstr "Nginx.conf bao gồm thư mục streams-enabled"

msgid "No DNS problem found"
msgstr "Không tìm thấy vấn đề DNS"

msgid "Original site configuration restored"
msgstr "Đã khôi phục cấu hình gốc của trang web"

msgid "Planning the HTTPS configuration"
msgstr "Đang lên kế hoạch cấu hình HTTPS"

msgid "Resolve the site configuration problem first"
msgstr "Giải quyết vấn đề cấu hình trang web trước"

msgid "Restoring the HTTP configuration"
msgstr "Đang khôi phục cấu hình HTTP"

msgid "Restoring the original site configuration"
msgstr "Đang khôi phục cấu hình gốc của trang web"

msgid "Sites directory exists"
msgstr "Thư mục trang web tồn tại"

msgid "Streams directory exists"
msgstr "Thư mục Streams tồn tại"

msgid "The DNS challenge does not use the HTTP challenge route"
msgstr "Thử thách DNS không sử dụng tuyến đường thử thách HTTP"

msgid ""
"The DNS lookup for the domain failed; make sure its name servers are "
"answering."
msgstr ""
"Tra cứu DNS cho tên miền thất bại; hãy đảm bảo các máy chủ tên của nó đang "
"phản hồi."

msgid ""
"The certificate %{name} covers the domains and is valid until %{not_after}"
msgstr "Chứng chỉ %{name} bao gồm các tên miền và có hiệu lực đến %{not_after}"

msgid "The certificate %{name} does not cover any of the domains: %{uncovered}"
msgstr "Chứng chỉ %{name} không bao phủ bất kỳ tên miền nào: %{uncovered}"

msgid ""
"The certificate %{name} does not cover some of the domains; they are left "
"out of HTTPS: %{uncovered}"
msgstr ""
"Chứng chỉ %{name} không bao gồm một số miền; các miền này bị loại khỏi "
"HTTPS: %{uncovered}"

msgid ""
"The certificate %{name} expired on %{not_after}; renew it or choose another "
"certificate"
msgstr ""
"Chứng chỉ %{name} đã hết hạn vào %{not_after}; hãy gia hạn hoặc chọn chứng "
"chỉ khác"

msgid ""
"The certificate authority could not connect to port 80 of this domain; open "
"TCP port 80 in the firewall or cloud security group and make sure any NAT or "
"port forwarding sends it to this server."
msgstr ""
"Cơ quan chứng thực không thể kết nối đến cổng 80 của miền này; hãy mở cổng "
"TCP 80 trong tường lửa hoặc nhóm bảo mật đám mây và đảm bảo mọi NAT hoặc "
"chuyển hướng cổng đều chuyển đến máy chủ này."

msgid ""
"The certificate authority could not resolve the domain; create an A or AAAA "
"record that points at this server and wait for DNS to propagate."
msgstr ""
"Cơ quan chứng thực không thể phân giải tên miền; hãy tạo bản ghi A hoặc AAAA "
"trỏ đến máy chủ này và đợi DNS lan truyền."

msgid ""
"The certificate authority followed a redirect, but the redirected request "
"did not reach the challenge route; make sure the HTTPS server for this host "
"also proxies /.well-known/acme-challenge/ to the challenge port, and that "
"the redirect stays on the same host and on port 80 or 443."
msgstr ""
"Cơ quan chứng thực đã theo dõi một chuyển hướng, nhưng yêu cầu được chuyển "
"hướng đã không đến được tuyến đường xác minh; hãy đảm bảo rằng máy chủ HTTPS "
"của máy chủ này cũng chuyển tiếp /.well-known/acme-challenge/ đến cổng xác "
"minh, và chuyển hướng vẫn ở trên cùng máy chủ và cổng 80 hoặc 443."

msgid ""
"The certificate authority rate limit was reached; wait until the retry time "
"before trying again, and test configuration changes against the staging "
"environment."
msgstr ""
"Đã đạt giới hạn tốc độ của cơ quan chứng chỉ; hãy đợi đến thời gian thử lại "
"trước khi thử lại, và kiểm tra các thay đổi cấu hình trên môi trường staging."

msgid ""
"The certificate authority reached a server that did not return the challenge "
"file, and the domain resolves to an address that is not on this server; "
"point the domain's A/AAAA records at this server, or, behind NAT or a CDN, "
"make sure port 80 is forwarded to it."
msgstr ""
"Cơ quan chứng chỉ đã kết nối đến một máy chủ không trả về tệp xác minh và "
"tên miền được phân giải tới một địa chỉ không nằm trên máy chủ này; hãy trỏ "
"các bản ghi A/AAAA của tên miền tới máy chủ này, hoặc nếu ở sau NAT hoặc "
"CDN, hãy đảm bảo cổng 80 được chuyển tiếp tới máy chủ này."

msgid ""
"The certificate authority reached the server but the challenge file was not "
"served; make sure the port 80 server block for this domain is enabled and "
"routes /.well-known/acme-challenge/ to Nginx UI, and that no other server "
"block or proxy answers first."
msgstr ""
"Cơ quan chứng thực đã kết nối đến máy chủ nhưng tệp thử thách không được "
"cung cấp; hãy đảm bảo rằng khối máy chủ cổng 80 cho tên miền này đã được "
"kích hoạt và định tuyến /.well-known/acme-challenge/ đến Nginx UI, đồng thời "
"không có khối máy chủ nào khác hoặc proxy trả lời trước."

msgid ""
"The certificate authority refuses to issue a certificate for this name; use "
"a publicly resolvable domain name that the certificate authority supports."
msgstr ""
"Cơ quan chứng thực từ chối cấp chứng chỉ cho tên này; hãy sử dụng một tên "
"miền có thể phân giải công khai mà cơ quan chứng thực hỗ trợ."

msgid ""
"The certificate or key file of %{name} is missing or cannot be read; fix it "
"in the certificate manager or choose another certificate"
msgstr ""
"Tệp chứng chỉ hoặc khóa của %{name} bị thiếu hoặc không thể đọc được; hãy "
"sửa trong trình quản lý chứng chỉ hoặc chọn chứng chỉ khác"

msgid ""
"The domain has DNS address records, but the local addresses of this server "
"could not be compared."
msgstr ""
"Tên miền có các bản ghi địa chỉ DNS, nhưng không thể so sánh các địa chỉ cục "
"bộ của máy chủ này."

msgid ""
