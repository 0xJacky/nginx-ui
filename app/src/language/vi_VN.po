msgid "Private key content"
msgstr "Nội dung khóa riêng"

msgid "Choose private key file"
msgstr "Chọn tệp khóa riêng"

msgid "Private key path on Docker host (optional)"
msgstr "Đường dẫn khóa riêng trên host Docker (tùy chọn)"

msgid "Adds a read-only bind mount to the generated container instructions."
msgstr "Thêm một bind mount chỉ đọc vào hướng dẫn container được tạo ra."

msgid "Replace the stored private key with a new one?"
msgstr "Thay thế khóa riêng đã lưu bằng khóa mới?"

msgid ""
"The current key stops working until the new public key is installed on the "
"host."
msgstr ""
"Khóa hiện tại sẽ ngừng hoạt động cho đến khi khóa công khai mới được cài "
"trên host."

msgid "Regenerate"
msgstr "Tạo lại"

msgid "Regenerate keypair"
msgstr "Tạo lại cặp khóa"

msgid "Generate keypair"
msgstr "Tạo cặp khóa"

msgid "Validate existing key"
msgstr "Xác thực khóa hiện có"

msgid "Validate and save private key"
msgstr "Xác thực và lưu khóa riêng"

msgid "Key is readable"
msgstr "Khóa có thể đọc được"

msgid "Private key validation failed"
msgstr "Xác thực khóa riêng thất bại"

msgid "Public key"
msgstr "Khóa công khai"

msgid "Generate a keypair to continue, or open \"Use my own SSH key\" above."
msgstr ""
"Hãy tạo một cặp khóa để tiếp tục, hoặc mở \\\"Dùng khóa SSH của riêng tôi\\"
"\" ở trên."

msgid ""
"The Install step shows where to put this on the host. Nothing has been "
"installed there yet."
msgstr ""
"Bước Cài đặt cho biết cần đặt nội dung này ở đâu trên host. Hiện chưa có gì "
"được cài ở đó."

msgid "Private key generated (shown once)"
msgstr "Đã tạo khóa riêng (chỉ hiển thị một lần)"

