msgstr "Підключення SSH не було встановлено"

msgid "Trusted"
msgstr "Довірений"

msgid "New algorithm"
msgstr "Новий алгоритм"

msgid "Changed"
msgstr "Змінений"

msgid "Stale"
msgstr "Застарілий"

msgid "Unknown host"
