msgstr "Предлагаемое исправление"

msgid "nginx config directory is the host directory"
msgstr "Каталог конфигурации nginx является каталогом хоста"

msgid "nginx config directory is writable"
msgstr "Каталог конфигурации nginx доступен для записи"

msgid "Host platform matches the service manager"
msgstr "Платформа хоста соответствует менеджеру служб"

msgid "known_hosts is persisted"
msgstr "known_hosts сохраняется"

msgid "launchd service is loaded"
msgstr "Служба launchd загружена"

msgid "nginx log directory is readable"
msgstr "Каталог журналов nginx доступен для чтения"

msgid "nginx -t passes"
msgstr "nginx -t выполняется успешно"

msgid "nginx PID file is present"
msgstr "Файл PID nginx присутствует"

msgid "Target is the container host"
msgstr "Цель является хостом контейнера"

msgid "SSH connection"
msgstr "Подключение SSH"

msgid "Passwordless sudo is available"
msgstr "Доступен sudo без пароля"

msgid "sudoers rules cover the nginx commands"
msgstr "Правила sudoers охватывают команды nginx"

msgid "systemd unit is active"
msgstr "Юнит systemd активен"

msgid "systemd unit defines ExecReload"
msgstr "Юнит systemd определяет ExecReload"

msgid "Add a bind mount: -v %{source}:%{target}"
msgstr "Добавьте bind-монтирование: -v %{source}:%{target}"

msgid "Append the missing entries to %{path} (see the Install step)."
msgstr "Добавьте недостающие записи в %{path} (см. шаг «Установка»)."

msgid "Confirm that the address reaches the machine running nginx."
msgstr ""
"Убедитесь, что по этому адресу доступен компьютер, на котором работает "
"nginx."

msgid ""
"This is expected on Docker Desktop. On other runtimes, confirm that the "
"address reaches the machine running nginx."
msgstr ""
"Для Docker Desktop это ожидаемо. В других средах выполнения убедитесь, что "
"по этому адресу доступен компьютер, на котором работает nginx."

msgid ""
"Confirm that the SSH server is running, the user exists, and the key or "
"password is correct."
msgstr ""
"Убедитесь, что SSH-сервер запущен, пользователь существует, а ключ или "
"пароль указаны верно."

msgid ""
"Confirm that the systemd unit name matches the installation, such as "
"nginx.service or openresty.service."
msgstr ""
"Убедитесь, что имя юнита systemd соответствует установке, например "
"nginx.service или openresty.service."

msgid "Confirm that the configured SSH user owns the Homebrew service."
msgstr ""
"Убедитесь, что настроенный пользователь SSH является владельцем службы "
"Homebrew."

msgid "Confirm that the configured nginx directory exists on the host."
msgstr "Убедитесь, что настроенный каталог nginx существует на хосте."

msgid "Confirm that the container runtime provides host.docker.internal."
msgstr ""
"Убедитесь, что среда выполнения контейнеров предоставляет "
"host.docker.internal."

msgid "Confirm that /usr/bin/uname exists on the host."
msgstr "Убедитесь, что /usr/bin/uname существует на хосте."

msgid "Correct the highlighted path or identifier, then run verification again."
msgstr "Исправьте выделенный путь или идентификатор и снова запустите проверку."

msgid "Fix the nginx configuration error shown in the details."
msgstr "Исправьте ошибку конфигурации nginx, указанную в подробностях."

msgid "Run `sudo -l` on the host to inspect the configured permissions."
msgstr "Выполните `sudo -l` на хосте, чтобы проверить настроенные разрешения."

msgid "Inspect the systemd unit file."
msgstr "Проверьте файл юнита systemd."

msgid ""
"Bind-mount the host nginx log directory read-only at the configured "
"container log path, and ensure the container can read it."
msgstr ""
"Смонтируйте каталог журналов nginx хоста только для чтения по настроенному "
"пути журналов контейнера и убедитесь, что контейнер может его читать."

msgid ""
"Bind-mount the host PID directory containing %{path} at the same container "
"path."
msgstr ""
"Смонтируйте каталог PID хоста, содержащий %{path}, по тому же пути в "
"контейнере."

msgid ""
"Persist /etc/nginx-ui with a Docker named volume or bind mount so "
"known_hosts survives container rebuilds."
msgstr ""
"Сохраните /etc/nginx-ui в именованном томе Docker или bind-монтировании, "
"чтобы known_hosts сохранялся при пересоздании контейнера."

msgid "Replace the mount with: -v %{source}:%{target}"
msgstr "Замените монтирование на: -v %{source}:%{target}"

msgid "Some packages omit ExecReload. Use `systemctl restart` instead."
msgstr ""
"В некоторых пакетах отсутствует ExecReload. Используйте вместо него "
"`systemctl restart`."

msgid "If this is a remote host, review the cluster Node cross-host guide."
msgstr ""
"Если это удалённый хост, ознакомьтесь с руководством по работе узла "
"кластера между хостами."

msgid "Review the file permission commands in the Install step."
msgstr "Проверьте команды разрешений файлов на шаге «Установка»."

msgid "Review the sudoers rules shown in the Install step."
msgstr "Проверьте правила sudoers, показанные на шаге «Установка»."

msgid "Select the service manager that matches the SSH host."
msgstr "Выберите диспетчер служб, соответствующий SSH-хосту."

msgid "Run `brew services start nginx` as the configured SSH user."
msgstr ""
"Выполните `brew services start nginx` от имени настроенного пользователя "
"SSH."

msgid "Review the cluster Node cross-host guide for the correct deployment method."
msgstr ""
"Ознакомьтесь с руководством по работе узла кластера между хостами, чтобы "
"выбрать правильный способ развёртывания."

msgid "Use host.docker.internal when nginx runs on the Docker host."
msgstr "Используйте host.docker.internal, когда nginx работает на хосте Docker."

msgid "Use host.docker.internal when nginx runs on the macOS host."
msgstr "Используйте host.docker.internal, когда nginx работает на хосте macOS."

msgid "Verify the bind mount manually."
msgstr "Проверьте bind-монтирование вручную."

msgid "Clipboard access is unavailable in this browser context"
msgstr "Доступ к буферу обмена недоступен в этом контексте браузера"

msgid "Auto-detected"
msgstr "Определено автоматически"

msgid "Manual override"
msgstr "Ручное переопределение"

msgid "Detected:"
msgstr "Обнаружено:"

msgid "Restore detected value"
msgstr "Восстановить обнаруженное значение"

msgid "Point Nginx UI at a private key that already exists inside the container."
msgstr "Укажите Nginx UI закрытый ключ, который уже существует внутри контейнера."

msgid ""
"Paste or upload a private key. Nginx UI stores it at the managed path with "
"mode 0600."
msgstr ""
"Вставьте или загрузите закрытый ключ. Nginx UI сохранит его по управляемому "
"пути с правами доступа 0600."

msgid "Nginx UI generates an ed25519 keypair and stores it at the managed path."
msgstr "Nginx UI создает пару ключей ed25519 и сохраняет ее по управляемому пути."

msgid "No private key was found at this path"
msgstr "По этому пути не найден закрытый ключ."

msgid "Private key content is required"
msgstr "Требуется содержимое закрытого ключа"

msgid "Private key exceeds the 64 KiB limit"
msgstr "Закрытый ключ превышает лимит 64 КиБ"

msgid "Private key saved securely"
msgstr "Закрытый ключ надежно сохранен"

msgid "Use my own SSH key"
msgstr "Использовать собственный SSH-ключ"

msgid "Private key source"
msgstr "Источник закрытого ключа"

msgid "Existing path"
msgstr "Существующий путь"

msgid "Paste or upload"
msgstr "Вставить или загрузить"

msgid "The private key must already be available inside the Nginx UI container."
msgstr "Закрытый ключ уже должен быть доступен внутри контейнера Nginx UI."

msgid ""
"Encrypted private keys are not supported. You may provide the host-side "
"source path below to include a read-only bind mount in the generated "
"container instructions."
msgstr ""
"Зашифрованные закрытые ключи не поддерживаются. Ниже можно указать исходный "
"путь на стороне хоста, чтобы добавить монтирование только для чтения в "
"сгенерированные инструкции для контейнера."

msgid "Saving will replace the Nginx UI managed SSH private key."
msgstr "Сохранение заменит закрытый SSH-ключ, управляемый Nginx UI."

msgid ""
"Only unencrypted SSH private keys are accepted. The submitted content is "
"cleared from the browser after it is stored with file mode 0600."
msgstr ""
"Принимаются только незашифрованные закрытые ключи SSH. Отправленное "
"содержимое удаляется из браузера после сохранения с правами доступа 0600."

msgid "Private key path inside container"
msgstr "Путь к закрытому ключу внутри контейнера"

msgid "Managed by Nginx UI. Switch to \"Existing path\" to use another location."
msgstr ""
"Управляется Nginx UI. Переключитесь на \\\"Существующий путь\\\", чтобы "
"использовать другое расположение."

msgid "Private key content"
msgstr "Содержимое закрытого ключа"

msgid "Choose private key file"
msgstr "Выберите файл закрытого ключа"

msgid "Private key path on Docker host (optional)"
msgstr "Путь к закрытому ключу на хосте Docker (необязательно)"

msgid "Adds a read-only bind mount to the generated container instructions."
msgstr ""
"Добавляет монтирование только для чтения в сгенерированные инструкции для "
"контейнера."

msgid "Replace the stored private key with a new one?"
msgstr "Заменить сохраненный закрытый ключ новым?"

msgid ""
"The current key stops working until the new public key is installed on the "
"host."
msgstr ""
"Текущий ключ перестанет работать, пока новый открытый ключ не будет "
"установлен на хосте."

msgid "Regenerate"
msgstr "Сгенерировать заново"

msgid "Regenerate keypair"
msgstr "Сгенерировать пару ключей заново"

msgid "Generate keypair"
msgstr "Сгенерировать пару ключей"

msgid "Validate existing key"
msgstr "Проверить существующий ключ"

msgid "Validate and save private key"
msgstr "Проверить и сохранить закрытый ключ"

msgid "Key is readable"
msgstr "Ключ доступен для чтения"

msgid "Private key validation failed"
msgstr "Не удалось проверить закрытый ключ"

msgid "Public key"
msgstr "Открытый ключ"

msgid "Generate a keypair to continue, or open \"Use my own SSH key\" above."
msgstr ""
"Создайте пару ключей, чтобы продолжить, или откройте \\\"Использовать "
"собственный SSH-ключ\\\" выше."

msgid ""
"The Install step shows where to put this on the host. Nothing has been "
"installed there yet."
msgstr ""
"Шаг установки показывает, куда поместить это на хосте. Пока туда ничего не "
"установлено."

msgid "Private key generated (shown once)"
msgstr "Закрытый ключ создан (показывается один раз)"

msgid "Save this private key somewhere safe. It will NOT be shown again."
msgstr "Сохраните этот закрытый ключ в надежном месте. Он больше НЕ будет показан."

msgid "Trust every presented host key before testing the connection."
msgstr ""
"Сделайте доверенными все предъявленные ключи хоста перед проверкой "
"подключения."

msgid "Test SSH connection"
msgstr "Проверить подключение SSH"

msgid "SSH connection failed"
msgstr "Не удалось подключиться по SSH"

msgid "SSH connection succeeded"
msgstr "Подключение по SSH выполнено успешно"

msgid "SSH connection was not established"
msgstr "Подключение по SSH не было установлено"

msgid "Trusted"
msgstr "Доверенный"

msgid "New algorithm"
msgstr "Новый алгоритм"

msgid "Changed"
msgstr "Изменен"

msgid "Stale"
msgstr "Устаревший"

msgid "Unknown host"
msgstr "Неизвестный хост"

msgid "Verify the SSH host key before trusting it"
msgstr "Проверьте ключ хоста SSH, прежде чем доверять ему"

msgid ""
"Nginx UI can read the key presented by the SSH server, but it cannot prove "
"the key is genuine by itself. Verify the fingerprint through the host "
"console or another trusted channel before trusting or replacing it."
msgstr ""
"Nginx UI может прочитать ключ, предъявленный сервером SSH, но не может "
"самостоятельно доказать его подлинность. Проверьте отпечаток через консоль "
"хоста или другой доверенный канал, прежде чем доверять ему или заменять его."

msgid "Current target"
msgstr "Текущая цель"

msgid "SSH user"
msgstr "Пользователь SSH"

msgid "known_hosts"
msgstr "known_hosts"

msgid "1. Verify and trust the host key"
msgstr "1. Проверьте ключ хоста и добавьте его в доверенные"

msgid "Scan host keys"
msgstr "Просканировать ключи хоста"

msgid "Failed to scan host keys"
msgstr "Не удалось просканировать ключи хоста"

msgid "Failed to update trusted host keys"
msgstr "Не удалось обновить доверенные ключи хоста"

msgid "Paste ssh-keyscan output"
msgstr "Вставьте вывод ssh-keyscan"

msgid "Run on a trusted terminal"
msgstr "Выполните на доверенном терминале"

msgid "Parse pasted output"
msgstr "Разобрать вставленный вывод"

msgid "Fingerprint"
msgstr "Отпечаток"

msgid "Existing fingerprint"
msgstr "Существующий отпечаток"

msgid "I verified this fingerprint through a trusted channel."
msgstr "Я проверил этот отпечаток через доверенный канал."

msgid "Trust this algorithm"
msgstr "Доверять этому алгоритму"

msgid "Trust this key"
msgstr "Доверять этому ключу"

msgid ""
"Host key changed. Replace only after confirming an intentional host SSH key "
"rotation."
msgstr ""
"Ключ хоста изменился. Заменяйте только после подтверждения намеренной смены "
"SSH-ключа хоста."

msgid "I verified the new fingerprint through a trusted channel."
msgstr "Я проверил новый отпечаток через доверенный канал."

msgid "Replace trusted key"
msgstr "Заменить доверенный ключ"

msgid "No SSH host keys were returned"
msgstr "Ключи хоста SSH не были возвращены"

msgid "Advanced cleanup"
msgstr "Расширенная очистка"

msgid "I understand this removes only the selected stale known_hosts entry."
msgstr "Я понимаю, что это удалит только выбранную устаревшую запись known_hosts."

msgid "Delete stale key"
msgstr "Удалить устаревший ключ"

msgid "Host identity is trusted"
msgstr "Подлинность хоста подтверждена"

msgid "Resolve changed host keys before continuing."
msgstr "Устраните проблему с измененными ключами хоста, прежде чем продолжить."

msgid "The host presented a revoked key"
msgstr "Хост предоставил отозванный ключ"

msgid ""
"This key is marked @revoked in known_hosts. SSH will refuse it, so trusting "
"it here would only fail later. Investigate why the host is presenting a "
"revoked key before continuing."
msgstr ""
"Этот ключ помечен как @revoked в known_hosts. SSH отклонит его, поэтому "
"доверие к нему здесь приведёт к ошибке позднее. Перед продолжением "
"выясните, почему хост предоставляет отозванный ключ."

msgid "Paths refreshed from %{path}"
msgstr "Пути обновлены из %{path}"

msgid "Target diagnosis"
msgstr "Диагностика цели"

msgid "Detect again"
msgstr "Определить повторно"

msgid "Detect target"
msgstr "Определить цель"

msgid "Every field matches the detected values"
msgstr "Все поля совпадают с обнаруженными значениями"

msgid "Some fields differ from the detected values"
msgstr "Некоторые поля отличаются от обнаруженных значений"

msgid "Apply all detected values"
msgstr "Применить все обнаруженные значения"

msgid "Target diagnosis failed"
msgstr "Диагностика цели не удалась"

msgid "The target platform could not be classified automatically"
msgstr "Не удалось автоматически определить целевую платформу"

msgid "Choose the platform and confirm every path below manually, then continue."
msgstr "Выберите платформу, вручную подтвердите каждый путь ниже, затем продолжите."

msgid "Diagnosis completed with warnings"
msgstr "Диагностика завершена с предупреждениями"

msgid "Operating system"
msgstr "Операционная система"

msgid "Service manager"
msgstr "Менеджер служб"

msgid "Homebrew prefix"
msgstr "Префикс Homebrew"

msgid "Detected nginx version"
msgstr "Обнаруженная версия nginx"

msgid "nginx executable path"
msgstr "Путь к исполняемому файлу nginx"

msgid "Adjust detected values"
msgstr "Скорректировать обнаруженные значения"

msgid "Platform"
msgstr "Платформа"

msgid "Host platform"
msgstr "Платформа хоста"

msgid "Linux (systemd)"
msgstr "Linux (systemd)"

msgid "macOS (Homebrew)"
msgstr "macOS (Homebrew)"

msgid "Apple Silicon"
msgstr "Apple Silicon"

msgid "Intel Mac"
msgstr "Intel Mac"

msgid ""
"Detection fills this in. Switching it rewrites the four paths below that "
"still hold a conventional default."
msgstr ""
"Это поле заполняется при определении. Его переключение перезаписывает "
"четыре пути ниже, в которых остались стандартные значения."

msgid "systemd unit"
msgstr "Юнит systemd"

msgid "systemctl path"
msgstr "Путь к systemctl"

msgid "launchd service label"
msgstr "Метка службы launchd"

msgid "launchctl path"
msgstr "Путь к launchctl"

msgid "nginx paths"
msgstr "Пути nginx"

msgid "Re-detect paths from this executable"
msgstr "Заново определить пути из этого исполняемого файла"

msgid ""
"Runs nginx -V on the target and refreshes the config, log and PID paths "
"below."
msgstr ""
"Выполняет nginx -V на целевом хосте и обновляет пути к конфигурации, "
"журналам и PID ниже."

msgid "Could not read the nginx build configuration"
msgstr "Не удалось прочитать конфигурацию сборки nginx"

msgid "nginx config directory"
msgstr "Каталог конфигурации nginx"

msgid "nginx log directory"
msgstr "Каталог журналов nginx"

msgid "nginx PID file"
msgstr "Файл PID nginx"

msgid "Platform and paths are complete."
msgstr "Платформа и пути заполнены."

msgid "File access mode"
msgstr "Режим доступа к файлам"

msgid "Compatibility (SFTP)"
msgstr "Режим совместимости (SFTP)"

msgid "High performance (mounted)"
msgstr "Высокая производительность (монтирование)"

msgid ""
"Nginx UI reads configuration and logs from bind-mounted host directories. "
"This is faster, but requires recreating the container."
msgstr ""
"Nginx UI читает конфигурацию и журналы из каталогов хоста, подключённых "
"через bind-монтирование. Это быстрее, но требует пересоздания контейнера."

msgid ""
"Nginx UI reads configuration and logs entirely over SSH and SFTP. No host "
"directories are mounted into the container."
msgstr ""
"Nginx UI читает конфигурацию и журналы полностью через SSH и SFTP. Каталоги "
"хоста не монтируются в контейнер."

msgid "Failed to load setup instructions"
msgstr "Не удалось загрузить инструкции по настройке"

msgid "No container changes are required in compatibility mode"
msgstr "В режиме совместимости изменения контейнера не требуются"

msgid "Complete the host permissions below, then run the setup checks."
msgstr "Настройте разрешения хоста ниже, затем запустите проверки настройки."

msgid "1. On the nginx host"
msgstr "1. На хосте nginx"

msgid "2. On the Nginx UI container"
msgstr "2. В контейнере Nginx UI"

msgid "Run these on the machine that runs nginx, as a user who can use sudo."
msgstr ""
"Выполните это на машине, на которой работает nginx, от имени пользователя, "
"который может использовать sudo."

msgid "Run these on the machine that runs nginx, as the SSH user configured above."
msgstr ""
"Выполните это на машине, на которой работает nginx, от имени пользователя "
"SSH, настроенного выше."

msgid "Install the public key"
msgstr "Установить открытый ключ"

msgid ""
"Creates %{file} with the permissions sshd requires and appends the key. "
"sshd silently ignores an authorized_keys file that other users can write, "
"which shows up later as a permission denied error."
msgstr ""
"Создает %{file} с правами, которые требует sshd, и добавляет ключ. sshd "
"молча игнорирует файл authorized_keys, доступный для записи другим "
"пользователям, что позже проявляется как ошибка отказа в доступе."

msgid ""
"The same key on its own, for appending by hand. To restrict where it may be "
"used from, prefix it with from='…'."
msgstr ""
"Тот же ключ отдельно, для добавления вручную. Чтобы ограничить, откуда его "
"можно использовать, добавьте перед ним from='…'."

msgid "Open the sudoers file"
msgstr "Открыть файл sudoers"

msgid ""
"visudo checks the syntax before saving, so a typo cannot lock you out of "
"sudo."
msgstr ""
"visudo проверяет синтаксис перед сохранением, поэтому опечатка не лишит вас "
"доступа к sudo."

msgid "sudoers rules"
msgstr "Правила sudoers"

msgid ""
"Paste this into the editor visudo opened, then save and exit. It lets the "
"SSH user reload nginx without a password."
msgstr ""
"Вставьте это в редактор, открытый visudo, затем сохраните и выйдите. Это "
"позволит пользователю SSH перезагружать nginx без пароля."

msgid "File access check"
msgstr "Проверка доступа к файлам"

msgid "File permissions"
msgstr "Права доступа к файлу"

msgid ""
"Run as the SSH user. Both commands only test access and change nothing. A "
"failure means the SSH user cannot reach the Homebrew paths."
msgstr ""
"Выполните от имени пользователя SSH. Обе команды только проверяют доступ и "
"ничего не меняют. Сбой означает, что пользователь SSH не может обратиться к "
"путям Homebrew."

msgid ""
"Run as root. Grants the SSH user write access to the nginx config directory "
"and read access to the logs, including files created later, plus read "
"access to the PID file."
msgstr ""
"Выполните от имени root. Предоставляет пользователю SSH доступ на запись в "
"каталог конфигурации nginx и доступ на чтение к журналам, включая созданные "
"позже файлы, а также доступ на чтение к файлу PID."

msgid "Nothing else to install on the host"
msgstr "Больше ничего устанавливать на хосте не нужно"

msgid ""
"A Homebrew launchd service runs as the SSH user, so no sudoers entry or "
"extra permissions are needed."
msgstr ""
"Служба launchd из Homebrew работает от имени пользователя SSH, поэтому "
"запись в sudoers и дополнительные права не нужны."

msgid "The SSH user is root, so no sudoers entry or extra permissions are needed."
msgstr ""
"Пользователь SSH — root, поэтому запись в sudoers и дополнительные права не "
"нужны."

msgid ""
"Pick the format that matches how you run Nginx UI, then recreate the "
"container with the bind mounts."
msgstr ""
"Выберите формат, соответствующий способу запуска Nginx UI, затем "
"пересоздайте контейнер с bind-монтированиями."

msgid ""
"Linux Docker Engine requires this host-gateway mapping for "
"host.docker.internal. No directory mounts are added."
msgstr ""
"Docker Engine в Linux требует этого сопоставления host-gateway для "
"host.docker.internal. Монтирования каталогов не добавляются."

msgid "Recreating the container closes this page"
msgstr "Пересоздание контейнера закроет эту страницу"

msgid "Finish the host side first, then come back here."
msgstr "Сначала завершите настройку на стороне хоста, затем вернитесь сюда."

msgid ""
"Restarting Nginx UI ends the two-factor session and clears anything typed "
"in the earlier steps."
msgstr ""
"Перезапуск Nginx UI завершает двухфакторную сессию и очищает все, что было "
"введено на предыдущих шагах."

msgid ""
"The generated key and known_hosts survive, because they live under the "
"persisted /etc/nginx-ui directory."
msgstr ""
"Созданный ключ и known_hosts сохранятся, так как они находятся в постоянном "
"каталоге /etc/nginx-ui."

msgid ""
"Note the host address and SSH user before you recreate, then reopen the "
"wizard and verify again."
msgstr ""
"Запишите адрес хоста и пользователя SSH перед пересозданием, затем снова "
"откройте мастер и повторите проверку."

msgid "docker compose"
msgstr "docker compose"

msgid "override file"
msgstr "файл переопределения"

msgid "docker run"
msgstr "docker run"

msgid "docker-compose.yml"
msgstr "docker-compose.yml"

msgid ""
"Merge this under services.nginx-ui in your existing file. Each bind mount "
"uses the same path inside the container as on the host."
msgstr ""
"Добавьте это в раздел services.nginx-ui вашего существующего файла. Каждое "
"монтирование использует внутри контейнера тот же путь, что и на хосте."

msgid ""
"Merge this host-gateway mapping under services.nginx-ui in your existing "
"file."
msgstr ""
"Добавьте это сопоставление host-gateway в раздел services.nginx-ui "
"существующего файла."

msgid "docker-compose.override.yml"
msgstr "docker-compose.override.yml"

msgid ""
"Save as a new file next to your main compose file. Docker Compose merges it "
"automatically, so your original file stays untouched."
msgstr ""
"Сохраните как новый файл рядом с основным файлом compose. Docker Compose "
"объединит их автоматически, поэтому исходный файл останется без изменений."

msgid ""
"Replaces your current docker run command. Adjust the published port and the "
"image tag to match your current deployment."
msgstr ""
"Заменяет вашу текущую команду docker run. Скорректируйте публикуемый порт и "
"тег образа в соответствии с вашим текущим развертыванием."

msgid "Apply the change"
msgstr "Применить изменение"

msgid ""
"Remove the old container, then run the command above with the mounted host "
"directories."
msgstr ""
"Удалите старый контейнер и выполните приведённую выше команду со "
"смонтированными каталогами хоста."

msgid "The bind mounts take effect once the container is recreated."
msgstr "Bind-монтирования вступят в силу после пересоздания контейнера."

msgid "The host-gateway mapping takes effect once the container is recreated."
msgstr "Сопоставление host-gateway вступит в силу после пересоздания контейнера."

msgid "Setup checks"
msgstr "Проверки настройки"

msgid ""
"Run these after applying the relevant host and container instructions "
"above. They verify the service, file access and required privileges for the "
"selected mode."
msgstr ""
"Запустите эти проверки после применения приведённых выше инструкций для "
"хоста и контейнера. Они проверяют службу, доступ к файлам и необходимые "
"привилегии для выбранного режима."

msgid "SSH target"
msgstr "Цель SSH"

msgid "Host address (host:port)"
msgstr "Адрес хоста (host:port)"

msgid "This address answers on the SSH port."
msgstr "Этот адрес отвечает на порт SSH."

msgid "These addresses answer on the SSH port from this container:"
msgstr "Эти адреса отвечают на порт SSH из этого контейнера:"

msgid "Could not probe for reachable addresses: %{reason}"
msgstr "Не удалось проверить доступные адреса: %{reason}"

msgid "No address answered. Enter one manually, then use Probe again to test it."
msgstr ""
"Ни один адрес не ответил. Введите адрес вручную, затем нажмите «Проверить "
"повторно», чтобы протестировать его."

msgid "Probe again"
msgstr "Проверить повторно"

msgid "Remote address detected"
msgstr "Обнаружен удаленный адрес"

msgid "This mode only supports nginx-ui and target nginx on the same host."
msgstr ""
"Этот режим поддерживает работу nginx-ui и целевого nginx только на одном "
"хосте."

msgid ""
"bind-mount cannot reach remote filesystems, so config editing, log viewing "
"and certificate management will fail."
msgstr ""
"bind-mount не может обращаться к удаленным файловым системам, поэтому "
"редактирование конфигурации, просмотр журналов и управление сертификатами "
"работать не будут."

msgid "Use the cluster Node guide for cross-host setups."
msgstr ""
"Для настройки между разными хостами используйте руководство по узлам "
"кластера."

msgid "2. Test the SSH connection"
msgstr "2. Проверьте подключение SSH"

msgid "Verification"
msgstr "Проверка"

msgid ""
"The earlier steps already verified SSH, platform, file access and "
"privileges. This final check only runs nginx -t against the host "
"configuration."
msgstr ""
"На предыдущих шагах уже проверены SSH, платформа, доступ к файлам и "
"привилегии. Эта последняя проверка запускает только nginx -t для "
"конфигурации хоста."

msgid "Verification failed"
msgstr "Проверка не пройдена"

msgid "Run verification"
msgstr "Запустить проверку"

msgid "The nginx configuration on the host failed validation"
msgstr "Конфигурация nginx на хосте не прошла проверку"

msgid ""
"This is the configuration already present on the host, not something this "
"wizard wrote. The SSH setup itself can still be saved, and the "
"configuration can be fixed from Nginx UI afterwards."
msgstr ""
"Это конфигурация, уже присутствующая на хосте, а не созданная этим "
"мастером. Саму настройку SSH все равно можно сохранить, а конфигурацию "
"позже исправить из Nginx UI."

msgid "Continue without validating the configuration"
msgstr "Продолжить без проверки конфигурации"

msgid "Run the final nginx configuration check to enable saving."
msgstr "Выполните последнюю проверку конфигурации nginx, чтобы разрешить сохранение."

msgid "Enter the SSH host address."
msgstr "Введите адрес хоста SSH."

msgid "Enter the SSH user."
msgstr "Введите пользователя SSH."

msgid "Generate, validate or import a private key first."
msgstr "Сначала создайте, проверьте или импортируйте закрытый ключ."

msgid "Trust every presented host key first."
msgstr "Сначала сделайте доверенными все предъявленные ключи хоста."

msgid "Run the SSH connection test first."
msgstr "Сначала выполните проверку подключения SSH."

msgid "Fill in the platform and every nginx path below."
msgstr "Заполните платформу и все пути nginx ниже."

msgid "SSH Target"
msgstr "Цель SSH"

msgid "Address, user and private key"
msgstr "Адрес, пользователь и закрытый ключ"

msgid "Trust & Test"
msgstr "Доверие и проверка"

msgid "Host key and connectivity"
msgstr "Ключ хоста и связь"

msgid "Detect Platform"
msgstr "Определить платформу"

msgid "Service manager and nginx paths"
msgstr "Менеджер служб и пути nginx"

msgid "Access & Install"
msgstr "Доступ и установка"

msgid "File mode and setup instructions"
msgstr "Режим файлов и инструкции по настройке"

msgid "Verify"
msgstr "Проверить"

msgid "Run checks and save"
msgstr "Запустить проверки и сохранить"

msgid "Previous"
msgstr "Назад"

msgid "Save configuration"
msgstr "Сохранить конфигурацию"

msgid "%{count} unsaved change"
msgid_plural "%{count} unsaved changes"
msgstr[0] "%{count} несохранённое изменение"
msgstr[1] "%{count} несохранённых изменения"
msgstr[2] "%{count} несохранённых изменений"

msgid "Discard"
msgstr "Отменить"

msgid "Keep editing"
msgstr "Продолжить редактирование"

msgid "Search settings"
msgstr "Поиск по настройкам"

msgid "No matching settings"
msgstr "Нет подходящих настроек"

msgid "Check the format of the API Base Url and API Proxy."
msgstr "Проверьте формат API Base Url и API Proxy."

msgid "Failed to load settings"
msgstr "Не удалось загрузить настройки"

msgid ""
"The saved SSH access mode is missing or invalid. Set host_access_mode to "
"sftp or mounted in the configuration file."
msgstr ""
"Сохранённый режим доступа SSH отсутствует или недействителен. Укажите "
"host_access_mode со значением sftp или mounted в файле конфигурации."

msgid "Failed to authorize protected settings"
msgstr "Не удалось авторизовать защищенные настройки"

msgid "Failed to save Nginx control settings"
msgstr "Не удалось сохранить настройки управления Nginx"

msgid "Back to Nginx settings"
msgstr "Назад к настройкам Nginx"

msgid "Authorizing..."
msgstr "Авторизация..."

msgid "Enable two-factor authentication before changing Nginx control settings."
msgstr ""
"Включите двухфакторную аутентификацию перед изменением настроек управления "
"Nginx."

msgid "2FA Settings"
msgstr "Настройки 2FA"

msgid "Unable to open SSH setup"
msgstr "Не удалось открыть настройку SSH"

msgid "Basics"
msgstr "Основные"

msgid "Address, protocol and certificate used to reach this Nginx UI instance."
msgstr "Адрес, протокол и сертификат для доступа к этому экземпляру Nginx UI."

msgid "App"
msgstr "Приложение"

msgid "Sign-in session and list display of the web interface."
msgstr "Сессия входа и отображение списков в веб-интерфейсе."

msgid "Node"
msgstr "Узел"

msgid "Identity and display details of this node."
msgstr "Идентификация и параметры отображения этого узла."

msgid "Go to nodes"
msgstr "Перейти к узлам"

msgid "HTTP"
msgstr "HTTP"

msgid "Proxies used when Nginx UI connects to the internet."
msgstr "Прокси, используемые при подключении Nginx UI к интернету."

msgid "Auth"
msgstr "Авторизация"

msgid "Sign-in throttling, banned addresses and passkey origin."
msgstr "Ограничение попыток входа, заблокированные адреса и источник passkey."

msgid "Credentials for the command line, automation and MCP clients."
msgstr "Учётные данные для командной строки, автоматизации и клиентов MCP."

msgid "Cert"
