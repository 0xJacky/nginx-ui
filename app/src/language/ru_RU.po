msgstr ""
"Проверка в песочнице недоступна, поскольку настроена пользовательская "
"команда тестирования."

msgid "A required include file is missing from the sandbox or source configuration."
msgstr ""
"В песочнице или исходной конфигурации отсутствует необходимый включаемый "
"файл."

msgid "Sandbox setup failed before Nginx could validate the configuration."
msgstr ""
"Настройка песочницы завершилась неудачей до того, как Nginx смог проверить "
"конфигурацию."

msgid "Nginx reported a configuration syntax error."
msgstr "Nginx сообщил об ошибке синтаксиса в конфигурации."

msgid "Nginx failed to validate the configuration."
msgstr "Nginx не смог проверить конфигурацию."

