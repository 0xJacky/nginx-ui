#: src/views/preference/components/NginxHostSetup/checks.ts:18
msgid "nginx config directory is the host directory"
msgstr "Каталог конфигурации nginx является каталогом хоста"

#: src/views/preference/components/NginxHostSetup/checks.ts:19
msgid "nginx config directory is writable"
msgstr "Каталог конфигурации nginx доступен для записи"

#: src/views/preference/components/NginxHostSetup/checks.ts:20
msgid "Host platform matches the service manager"
msgstr "Платформа хоста соответствует менеджеру служб"

#: src/views/preference/components/NginxHostSetup/checks.ts:21
msgid "known_hosts is persisted"
msgstr "known_hosts сохраняется"

#: src/views/preference/components/NginxHostSetup/checks.ts:22
msgid "launchd service is loaded"
msgstr "Служба launchd загружена"

#: src/views/preference/components/NginxHostSetup/checks.ts:23
msgid "nginx log directory is readable"
msgstr "Каталог журналов nginx доступен для чтения"

#: src/views/preference/components/NginxHostSetup/checks.ts:24
msgid "nginx -t passes"
msgstr "nginx -t выполняется успешно"

#: src/views/preference/components/NginxHostSetup/checks.ts:25
msgid "nginx PID file is present"
msgstr "Файл PID nginx присутствует"

#: src/views/preference/components/NginxHostSetup/checks.ts:26
msgid "Target is the container host"
msgstr "Цель является хостом контейнера"

#: src/views/preference/components/NginxHostSetup/checks.ts:27
msgid "SSH connection"
msgstr "Подключение SSH"

#: src/views/preference/components/NginxHostSetup/checks.ts:28
msgid "Passwordless sudo is available"
msgstr "Доступен sudo без пароля"

#: src/views/preference/components/NginxHostSetup/checks.ts:29
msgid "sudoers rules cover the nginx commands"
msgstr "Правила sudoers охватывают команды nginx"

#: src/views/preference/components/NginxHostSetup/checks.ts:30
msgid "systemd unit is active"
msgstr "Юнит systemd активен"

#: src/views/preference/components/NginxHostSetup/checks.ts:31
msgid "systemd unit defines ExecReload"
msgstr "Юнит systemd определяет ExecReload"

#: src/views/preference/components/NginxHostSetup/checks.ts:35
msgid "Add a bind mount: -v %{source}:%{target}"
msgstr "Добавьте bind-монтирование: -v %{source}:%{target}"

#: src/views/preference/components/NginxHostSetup/checks.ts:39
msgid "Append the missing entries to %{path} (see the Install step)."
msgstr "Добавьте недостающие записи в %{path} (см. шаг «Установка»)."

#: src/views/preference/components/NginxHostSetup/checks.ts:42
msgid "Confirm that the address reaches the machine running nginx."
msgstr ""
"Убедитесь, что по этому адресу доступен компьютер, на котором работает "
"nginx."

#: src/views/preference/components/NginxHostSetup/checks.ts:43
msgid ""
"This is expected on Docker Desktop. On other runtimes, confirm that the "
"address reaches the machine running nginx."
msgstr ""
"Для Docker Desktop это ожидаемо. В других средах выполнения убедитесь, что "
"по этому адресу доступен компьютер, на котором работает nginx."

#: src/views/preference/components/NginxHostSetup/checks.ts:44
msgid ""
"Confirm that the SSH server is running, the user exists, and the key or "
"password is correct."
msgstr ""
"Убедитесь, что SSH-сервер запущен, пользователь существует, а ключ или "
"пароль указаны верно."

#: src/views/preference/components/NginxHostSetup/checks.ts:45
msgid ""
"Confirm that the systemd unit name matches the installation, such as "
"nginx.service or openresty.service."
msgstr ""
"Убедитесь, что имя юнита systemd соответствует установке, например "
"nginx.service или openresty.service."

#: src/views/preference/components/NginxHostSetup/checks.ts:46
msgid "Confirm that the configured SSH user owns the Homebrew service."
msgstr ""
"Убедитесь, что настроенный пользователь SSH является владельцем службы "
"Homebrew."

#: src/views/preference/components/NginxHostSetup/checks.ts:47
msgid "Confirm that the configured nginx directory exists on the host."
msgstr "Убедитесь, что настроенный каталог nginx существует на хосте."

#: src/views/preference/components/NginxHostSetup/checks.ts:48
msgid "Confirm that the container runtime provides host.docker.internal."
msgstr ""
"Убедитесь, что среда выполнения контейнеров предоставляет "
"host.docker.internal."

#: src/views/preference/components/NginxHostSetup/checks.ts:49
msgid "Confirm that /usr/bin/uname exists on the host."
msgstr "Убедитесь, что /usr/bin/uname существует на хосте."

#: src/views/preference/components/NginxHostSetup/checks.ts:50
msgid "Correct the highlighted path or identifier, then run verification again."
msgstr "Исправьте выделенный путь или идентификатор и снова запустите проверку."

#: src/views/preference/components/NginxHostSetup/checks.ts:51
msgid "Fix the nginx configuration error shown in the details."
msgstr "Исправьте ошибку конфигурации nginx, указанную в подробностях."

#: src/views/preference/components/NginxHostSetup/checks.ts:52
msgid "Run `sudo -l` on the host to inspect the configured permissions."
msgstr "Выполните `sudo -l` на хосте, чтобы проверить настроенные разрешения."

#: src/views/preference/components/NginxHostSetup/checks.ts:53
msgid "Inspect the systemd unit file."
msgstr "Проверьте файл юнита systemd."

#: src/views/preference/components/NginxHostSetup/checks.ts:54
msgid ""
"Bind-mount the host nginx log directory read-only at the configured "
"container log path, and ensure the container can read it."
msgstr ""
"Смонтируйте каталог журналов nginx хоста только для чтения по настроенному "
"пути журналов контейнера и убедитесь, что контейнер может его читать."

#: src/views/preference/components/NginxHostSetup/checks.ts:55
msgid ""
"Bind-mount the host PID directory containing %{path} at the same container "
"path."
msgstr ""
"Смонтируйте каталог PID хоста, содержащий %{path}, по тому же пути в "
"контейнере."

#: src/views/preference/components/NginxHostSetup/checks.ts:58
msgid ""
"Persist /etc/nginx-ui with a Docker named volume or bind mount so "
"known_hosts survives container rebuilds."
msgstr ""
"Сохраните /etc/nginx-ui в именованном томе Docker или bind-монтировании, "
"чтобы known_hosts сохранялся при пересоздании контейнера."

#: src/views/preference/components/NginxHostSetup/checks.ts:59
msgid "Replace the mount with: -v %{source}:%{target}"
msgstr "Замените монтирование на: -v %{source}:%{target}"

#: src/views/preference/components/NginxHostSetup/checks.ts:63
msgid "Some packages omit ExecReload. Use `systemctl restart` instead."
msgstr ""
"В некоторых пакетах отсутствует ExecReload. Используйте вместо него "
"`systemctl restart`."

#: src/views/preference/components/NginxHostSetup/checks.ts:64
msgid "If this is a remote host, review the cluster Node cross-host guide."
msgstr ""
"Если это удалённый хост, ознакомьтесь с руководством по работе узла "
"кластера между хостами."

#: src/views/preference/components/NginxHostSetup/checks.ts:65
msgid "Review the file permission commands in the Install step."
msgstr "Проверьте команды разрешений файлов на шаге «Установка»."

#: src/views/preference/components/NginxHostSetup/checks.ts:66
msgid "Review the sudoers rules shown in the Install step."
msgstr "Проверьте правила sudoers, показанные на шаге «Установка»."

#: src/views/preference/components/NginxHostSetup/checks.ts:67
msgid "Select the service manager that matches the SSH host."
msgstr "Выберите диспетчер служб, соответствующий SSH-хосту."

#: src/views/preference/components/NginxHostSetup/checks.ts:68
msgid "Run `brew services start nginx` as the configured SSH user."
msgstr ""
"Выполните `brew services start nginx` от имени настроенного пользователя "
"SSH."

#: src/views/preference/components/NginxHostSetup/checks.ts:69
msgid "Review the cluster Node cross-host guide for the correct deployment method."
msgstr ""
"Ознакомьтесь с руководством по работе узла кластера между хостами, чтобы "
"выбрать правильный способ развёртывания."

#: src/views/preference/components/NginxHostSetup/checks.ts:70
msgid "Use host.docker.internal when nginx runs on the Docker host."
msgstr "Используйте host.docker.internal, когда nginx работает на хосте Docker."

#: src/views/preference/components/NginxHostSetup/checks.ts:71
msgid "Use host.docker.internal when nginx runs on the macOS host."
msgstr "Используйте host.docker.internal, когда nginx работает на хосте macOS."

#: src/views/preference/components/NginxHostSetup/checks.ts:72
msgid "Verify the bind mount manually."
msgstr "Проверьте bind-монтирование вручную."

#: src/views/preference/components/NginxHostSetup/CodeBlock.vue:30
msgid "Clipboard access is unavailable in this browser context"
msgstr "Доступ к буферу обмена недоступен в этом контексте браузера"

#: src/views/preference/components/NginxHostSetup/PathField.vue:35
msgid "Auto-detected"
msgstr "Определено автоматически"

#: src/views/preference/components/NginxHostSetup/PathField.vue:39
msgid "Manual override"
msgstr "Ручное переопределение"

#: src/views/preference/components/NginxHostSetup/PathField.vue:49
msgid "Detected:"
msgstr "Обнаружено:"

#: src/views/preference/components/NginxHostSetup/PathField.vue:56
msgid "Restore detected value"
msgstr "Восстановить обнаруженное значение"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:73
msgid "Point Nginx UI at a private key that already exists inside the container."
msgstr "Укажите Nginx UI закрытый ключ, который уже существует внутри контейнера."

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:75
msgid ""
"Paste or upload a private key. Nginx UI stores it at the managed path with "
"mode 0600."
msgstr ""
"Вставьте или загрузите закрытый ключ. Nginx UI сохранит его по управляемому "
"пути с правами доступа 0600."

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:77
msgid "Nginx UI generates an ed25519 keypair and stores it at the managed path."
msgstr "Nginx UI создает пару ключей ed25519 и сохраняет ее по управляемому пути."

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:95
msgid "Private key path is required"
msgstr "Требуется путь к закрытому ключу"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:115
msgid "No private key was found at this path"
msgstr "По этому пути не найден закрытый ключ."

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:141
msgid "Private key content is required"
msgstr "Требуется содержимое закрытого ключа"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:145
#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:167
msgid "Private key exceeds the 64 KiB limit"
msgstr "Закрытый ключ превышает лимит 64 КиБ"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:159
msgid "Private key saved securely"
msgstr "Закрытый ключ надежно сохранен"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:197
msgid "Use my own SSH key"
msgstr "Использовать собственный SSH-ключ"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:200
msgid "Private key source"
msgstr "Источник закрытого ключа"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:206
msgid "Existing path"
msgstr "Существующий путь"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:207
msgid "Paste or upload"
msgstr "Вставить или загрузить"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:222
msgid "The private key must already be available inside the Nginx UI container."
msgstr "Закрытый ключ уже должен быть доступен внутри контейнера Nginx UI."

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:223
msgid ""
"Encrypted private keys are not supported. You may provide the host-side "
"source path below to include a read-only bind mount in the generated "
"container instructions."
msgstr ""
"Зашифрованные закрытые ключи не поддерживаются. Ниже можно указать исходный "
"путь на стороне хоста, чтобы добавить монтирование только для чтения в "
"сгенерированные инструкции для контейнера."

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:231
msgid "Saving will replace the Nginx UI managed SSH private key."
msgstr "Сохранение заменит закрытый SSH-ключ, управляемый Nginx UI."

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:232
msgid ""
"Only unencrypted SSH private keys are accepted. The submitted content is "
"cleared from the browser after it is stored with file mode 0600."
msgstr ""
"Принимаются только незашифрованные закрытые ключи SSH. Отправленное "
"содержимое удаляется из браузера после сохранения с правами доступа 0600."

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:235
msgid "Private key path inside container"
msgstr "Путь к закрытому ключу внутри контейнера"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:243
msgid "Managed by Nginx UI. Switch to \"Existing path\" to use another location."
msgstr ""
"Управляется Nginx UI. Переключитесь на \\\"Существующий путь\\\", чтобы "
"использовать другое расположение."

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:248
msgid "Private key content"
msgstr "Содержимое закрытого ключа"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:258
msgid "Choose private key file"
msgstr "Выберите файл закрытого ключа"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:272
msgid "Private key path on Docker host (optional)"
msgstr "Путь к закрытому ключу на хосте Docker (необязательно)"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:277
msgid "Adds a read-only bind mount to the generated container instructions."
msgstr ""
"Добавляет монтирование только для чтения в сгенерированные инструкции для "
"контейнера."

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:289
msgid "Replace the stored private key with a new one?"
msgstr "Заменить сохраненный закрытый ключ новым?"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:290
msgid ""
"The current key stops working until the new public key is installed on the "
"host."
msgstr ""
"Текущий ключ перестанет работать, пока новый открытый ключ не будет "
"установлен на хосте."

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:291
msgid "Regenerate"
msgstr "Сгенерировать заново"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:297
msgid "Regenerate keypair"
msgstr "Сгенерировать пару ключей заново"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:302
msgid "Generate keypair"
msgstr "Сгенерировать пару ключей"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:313
msgid "Validate existing key"
msgstr "Проверить существующий ключ"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:324
msgid "Validate and save private key"
msgstr "Проверить и сохранить закрытый ключ"

#: src/views/preference/components/NginxHostSetup/steps/AuthenticationMethod.vue:329
