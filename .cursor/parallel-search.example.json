{
  "mcpServers": {
    "parallel-search": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "mcp-remote@0.14.3",
        "https://search.parallel.ai/mcp",
        "--transport",
        "http-only",
        "--enable-proxy",
        "--header",
        "User-Agent:Nginx-UI-Parallel-Search-Example/1.0"
      ]
    }
  }
}
