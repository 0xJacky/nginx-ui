#!/bin/sh
# Build the plugin binary for the current platform and drop it where
# plugin.json's server.executables entry expects it.
set -eu

cd "$(dirname "$0")"
mkdir -p "$(dirname "{{.ExecutablePath}}")"
go build -o "{{.ExecutablePath}}" .
chmod +x "{{.ExecutablePath}}"
echo "built {{.ExecutablePath}}"
