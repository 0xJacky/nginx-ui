#!/command/with-contenv sh

if [ "${NGINX_UI_DISABLE_BUNDLED_NGINX:-}" = "true" ]; then
    echo "Bundled Nginx is disabled; keeping the service idle"
    exec sleep infinity
fi

if [ -n "${TZ}" ]; then
    echo "Timezone: ${TZ}"
    ln -sf "/usr/share/zoneinfo/${TZ}" /etc/localtime && \
    echo "${TZ}" > /etc/timezone
fi

# exec hands the service process to Nginx itself. Without it s6 supervises
# this shell, and stopping or restarting the service only kills the shell
# while the Nginx master keeps running outside s6, holding the ports.
exec nginx -g "daemon off;"
